APP_ENV=dev
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
EMBEDDING_PROVIDER=local
GENERATION_PROVIDER=local
OPENAI_API_KEY=sk-...
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_EXPANSION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
INDEX_PATH=data/index.jsonl
FEEDBACK_DB_PATH=data/feedback.sqlite3
ALLOWED_CHANNEL_IDS=

# MCP server (optional; pip install -r requirements-mcp.txt)
MCP_PORT=8090
# "off" = no auth, local demo only. "jwt" = OAuth 2.1 resource server.
MCP_AUTH_MODE=off
# Your identity provider's issuer URL, e.g. https://idp.example.com/oauth2/default
MCP_AUTH_ISSUER=
# Expected audience claim, e.g. api://slack-rag-skeleton
MCP_AUTH_AUDIENCE=
# Optional explicit JWKS URL; discovered from the issuer when empty
MCP_AUTH_JWKS_URL=
# Public URL of this MCP server, used in protected-resource metadata
MCP_RESOURCE_URL=

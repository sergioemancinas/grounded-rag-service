# citespine configuration reference.
# Guarantee: an EMPTY file (or no .env at all) boots the full offline stack:
# local hash embeddings, extractive generation, JSONL retrieval, no network.
# Every line below is optional; uncomment only what you change.

# --- Core ---------------------------------------------------------------
# APP_ENV=dev
# INDEX_PATH=data/index.jsonl
# FEEDBACK_DB_PATH=data/feedback.sqlite3
# Secret keying the feedback digests. Unset derives a random per-process key,
# so digests stay unlinkable but cannot be compared across restarts. Set this
# in production if you want verdict counts to aggregate per user over time.
# FEEDBACK_HMAC_KEY=

# --- Providers ----------------------------------------------------------
# Switch matrix: local (default, offline) | openai (requires OPENAI_API_KEY)
# EMBEDDING_PROVIDER=local
# GENERATION_PROVIDER=local
# Grounding judge: empty = auto (llm when generation is openai, else heuristic)
# GROUNDING_JUDGE=
# OPENAI_API_KEY=
# OPENAI_GENERATION_MODEL=gpt-4o
# OPENAI_EXPANSION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dotted-path escape hatches (win over the *_PROVIDER names above).
# These import and run operator-supplied code at startup: set them only
# here or in the environment, never from request data.
# EMBEDDER_CLASS=mypkg.embed:MyEmbedder
# GENERATOR_CLASS=
# RERANKER_CLASS=
# RETRIEVER_CLASS=
# GROUNDING_JUDGE_CLASS=

# --- Retrieval tuning ---------------------------------------------------
# MAX_CONTEXT_CHUNKS=10
# MAX_CONTEXT_CHARS_PER_CHUNK=2600
# RERANK_ENABLED=false
# RERANK_POOL=75
# LEXICAL_SCORER=bm25
# BM25_K1=1.2
# BM25_B=0.75
# CONTEXT_MAX_PER_DOC=2
# MMR_LAMBDA=0.7
# GROUNDING_CHECK_ENABLED=true
# GROUNDING_MIN_SCORE=0.55
# CACHE_ENABLED=true
# CACHE_SIMILARITY=0.97
# CACHE_TTL_SECONDS=7200
# ROUTER_ENABLED=true

# --- Prompts ------------------------------------------------------------
# Directory of *.md files shadowing app/prompts/ (same filenames win)
# PROMPTS_DIR=

# --- API auth -----------------------------------------------------------
# Static bearer token required on /v1/* when set (empty = no auth).
# Set this before exposing the service beyond localhost.
# API_AUTH_TOKEN=

# --- Slack adapter (optional) -------------------------------------------
# The adapter mounts only when SLACK_SIGNING_SECRET is set.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# Comma-separated channel ids the bot answers in (empty = all)
# ALLOWED_CHANNEL_IDS=

# --- MCP server (optional; pip install -r requirements-mcp.txt) ----------
# MCP_PORT=8090
# "off" = no auth, local demo only. "jwt" = OAuth 2.1 resource server.
# MCP_AUTH_MODE=off
# Your identity provider's issuer URL, e.g. https://idp.example/oauth2/default
# MCP_AUTH_ISSUER=
# Expected audience claim; must equal the canonical URL including /mcp
# MCP_AUTH_AUDIENCE=
# Optional explicit JWKS URL; discovered from the issuer when empty
# MCP_AUTH_JWKS_URL=
# Accepted JWT algorithms, comma-separated (anything else is rejected)
# MCP_AUTH_ALGORITHMS=RS256
# Canonical public URL of this MCP server, including the /mcp path. This
# exact string is the metadata resource, the challenge pointer, and the
# audience your identity provider must mint into tokens.
# MCP_RESOURCE_URL=https://rag.example.com/mcp
# Comma-separated scopes required on MCP tokens (missing scope = 403)
# MCP_REQUIRED_SCOPES=
# Module exposing register(server, deps, settings) to add custom tools
# MCP_EXTENSIONS_MODULE=
# Override the built-in tool descriptions shown to MCP clients
# MCP_TOOL_SEARCH_DESCRIPTION=
# MCP_TOOL_FETCH_DESCRIPTION=
# MCP_TOOL_ASK_DESCRIPTION=
